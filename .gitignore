# Environments and tool caches
.venv/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Owner-supplied data and run output (CC §7, §10); tuning summaries/reports stay committable
test-audio/
benches/results/raw/
benches/results/*.jsonl
benches/results/tuning/**/raw/

# Audio and non-bundled model weights are never committed. The pinned FP-1b ONNX asset is an
# explicit exception so deployments are self-contained.
*.wav
*.mp3
*.flac
*.ogg
*.opus
*.m4a
*.onnx
!ai-music-detector/src/aidetect/resources/ai_music_detector.onnx
*.pt
*.pth
*.safetensors
*.bin

# Credentials
.env
